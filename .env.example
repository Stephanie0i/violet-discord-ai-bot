# ───────────── Discord ─────────────
# Developer Portal > your NEW "Violet" application > Bot > Reset Token  (never reuse another bot's token)
DISCORD_TOKEN=

# Optional. Your server's ID: slash commands then appear instantly. Leave empty for global commands
# (those can take up to an hour to show up the first time).
GUILD_ID=

# Optional. Comma-separated channel IDs where Violet may answer @mentions. Empty = every channel.
ALLOWED_CHANNEL_IDS=

# Answer when people DM her? (true/false)
ALLOW_DMS=true

# Leave "false": mentions and DMs work without this privileged intent. Only set true if you ALSO enable
# "Message Content Intent" in the Developer Portal and want her to read replies sent without pinging her.
ENABLE_MESSAGE_CONTENT=false

# auto = sync slash commands only when they changed (recommended) | always | never
SYNC_COMMANDS=auto

# ───────────── Language service (any OpenAI-compatible API) ─────────────
# All three are required for AI replies. Without them Violet still starts and politely says she is not configured.
# Example base URLs (check your provider's dashboard for current model names and free-tier limits):
#   NVIDIA NIM  https://integrate.api.nvidia.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenAI      https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.6
LLM_MAX_CONCURRENT=2

# ───────────── Fair use (protects your free API quota) ─────────────
USER_COOLDOWN_SECONDS=8
USER_HOURLY_LIMIT=30
DAILY_REQUEST_LIMIT=600

# ───────────── Memory & presence ─────────────
# Recent turns remembered per user per channel (RAM only, forgotten after the TTL). 0 disables memory.
MEMORY_TURNS=6
MEMORY_TTL_SECONDS=900
STATUS_INTERVAL_MINUTES=5

LOG_LEVEL=INFO
